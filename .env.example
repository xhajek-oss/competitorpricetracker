# Server
PORT=3000
NODE_ENV=development

# Security — Set an API key to protect your instance.
# If empty, the API is open (only safe for local use).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEY=

# Multi-user auth (optional) — Comma-separated label:key pairs
# Example: API_KEYS=admin:abc123,reader:def456
# Supports both API_KEY (single) and API_KEYS (multiple) simultaneously.
API_KEYS=

# Restrict which origins can call the API (e.g., http://localhost:3000)
# If empty, only same-origin requests are allowed.
ALLOWED_ORIGIN=

# Resend (Email Notifications)
RESEND_API_KEY=re_your_api_key_here
NOTIFICATION_FROM_EMAIL=alerts@yourdomain.com
NOTIFICATION_TO_EMAIL=your@email.com

# Telegram (Optional)
# 1. Message @BotFather on Telegram, send /newbot, follow instructions
# 2. Copy the bot token below
# 3. Start a chat with your bot, then visit:
#    https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates
#    to find your chat_id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Webhook (Optional) — Receives JSON POST on price changes
WEBHOOK_URL=

# Scraper
SCRAPER_TIMEOUT_MS=30000
SCRAPER_HEADLESS=true

# Proxy (Optional) — Route scraper traffic through a proxy
# Supports http, https, socks5 protocols
# Example: PROXY_URL=http://proxy.example.com:8080
PROXY_URL=
